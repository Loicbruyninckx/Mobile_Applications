{
  "expo": {
    "name": "Bierapp",
    "slug": "bierapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./public/icon-512.png",
    "scheme": "bierapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./public/icon-512.png",
        "backgroundColor": "#3B2314"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./public/icon-192.png",
      "name": "Bierapp",
      "shortName": "Bierapp",
      "lang": "nl",
      "themeColor": "#3B2314",
      "backgroundColor": "#FBF7EF"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
